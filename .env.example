# Obrigatório em publicação. Gere com: openssl rand -hex 32
ADMIN_TOKEN=
PORT=8787
HOST=127.0.0.1

# Integração opcional e não oficial. Sem @.
TIKTOK_USERNAME=
TIKTOK_AUTO_CONNECT=false

# Em hospedagem HTTPS, use true e um ADMIN_TOKEN forte.
# No Mac, use true somente se o acesso estiver protegido por Tailscale/VPN e firewall.
REMOTE_ACCESS=false
DATABASE_PATH=./data/live-arena.sqlite
LOG_LEVEL=info

# Silêncio absoluto ao iniciar (padrão). false = o áudio já nasce liberado.
AUDIO_SAFE_MODE=true
